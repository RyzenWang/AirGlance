<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Every icon lives on the same 24 x 24 design grid, matching the SVGs in
    docs/design/interaction-v2.html. IconPath scales the whole grid into the
    requested box, so the artwork stays centred instead of drifting to the
    bottom-right and clipping when the box is smaller than 24 px.
  -->
  <StreamGeometry x:Key="IconClose">M 6 6 L 18 18 M 18 6 L 6 18</StreamGeometry>
  <StreamGeometry x:Key="IconMinimize">M 5 12 H 19</StreamGeometry>

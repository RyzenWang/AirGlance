<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AirGlance.App.Controls">
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
  </Style>

  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource InkTertiary}" />
  </Style>

  <Style Selector="TextBlock.sectionLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.6" />
    <Setter Property="Foreground" Value="{DynamicResource InkTertiary}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource PanelCornerRadius}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource IconButtonCornerRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>

  <Style Selector="Button.icon:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Border}" />
  </Style>

  <Style Selector="Button.caption">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>

  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
  </Style>

  <Style Selector="Button.caption.close:pointerover controls|IconPath">
    <Setter Property="Stroke" Value="{DynamicResource OnCoral}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Height" Value="42" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="Background" Value="{DynamicResource Coral}" />
    <Setter Property="Foreground" Value="{DynamicResource OnCoral}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Coral}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Height" Value="42" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.zoom-link">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="Button:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Coral}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.icon controls|IconPath">
    <Setter Property="Stroke" Value="{DynamicResource Ink}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <Style Selector="Button.caption controls|IconPath">
    <Setter Property="Stroke" Value="{DynamicResource Ink}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>

  <Style Selector="ListBox.filmstrip">
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <Style Selector="ListBox.filmstrip ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ListBox.filmstrip ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>

  <Style Selector="ListBox.filmstrip ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>

  <Style Selector="ListBox.filmstrip ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Coral}" />
  </Style>

  <Style Selector="ListBox.filmstrip TextBlock.image-name">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="ListBox.filmstrip ListBoxItem:selected TextBlock.image-name">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="TextBox.path">
    <Setter Property="Height" Value="36" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="ComboBox.settings">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinWidth" Value="168" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ChipCornerRadius}" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Window.shell">
    <Setter Property="Background" Value="{DynamicResource Paper}" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="Border.titlebar">
    <Setter Property="Background" Value="{DynamicResource Paper}" />
  </Style>

  <Style Selector="Border.brandmark">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource Coral}" />
  </Style>

  <Style Selector="TextBlock.brand-name">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.filename">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="Border.filmstrip-host">
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{DynamicResource Paper}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="TextBlock.status-text">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.status-dot">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource InkTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.transient">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Caution}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.overlay-title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.overlay-message">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.overlay-hint">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource InkTertiary}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.loading-chip">
    <Setter Property="Background" Value="{DynamicResource Scrim}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ChipCornerRadius}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,0,20" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="Border.dragover">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="#01000000" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="TextBlock.drop-hint">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Border}" />
  </Style>

  <Style Selector="Border.canvas">
    <Setter Property="Background" Value="{DynamicResource CanvasBackdrop}" />
  </Style>

  <Style Selector="Border.canvas.fullscreen">
    <Setter Property="Background" Value="{DynamicResource CanvasFullscreen}" />
  </Style>

  <!-- Image-first overlay chrome. Dark translucent surfaces sit over any photo. -->
  <Style Selector="Grid.dual-root">
    <Setter Property="Background" Value="{DynamicResource CanvasBackdrop}" />
  </Style>

  <Style Selector="Border.dual-pane">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.dual-active-frame">
    <Setter Property="Margin" Value="8" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="BoxShadow" Value="0 0 24 -8 #33E3563B" />
  </Style>

  <Style Selector="Border.dual-active-frame.a">
    <Setter Property="BorderBrush" Value="{DynamicResource Coral}" />
  </Style>

  <Style Selector="Border.dual-active-frame.b">
    <Setter Property="BorderBrush" Value="{DynamicResource Teal}" />
    <Setter Property="BoxShadow" Value="0 0 24 -8 #332E6F63" />
  </Style>

  <Style Selector="Border.dual-pane-nav">
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="Margin" Value="0,64,0,0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="#E00A0E13" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="0 12 34 0 #3D05080B" />
  </Style>

  <Style Selector="Border.dual-pane-nav.a">
    <Setter Property="BorderBrush" Value="#7AE3563B" />
  </Style>

  <Style Selector="Border.dual-pane-nav.b">
    <Setter Property="BorderBrush" Value="#7A2E6F63" />
  </Style>

  <Style Selector="Border.dual-pane-nav-badge">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>

  <Style Selector="Border.dual-pane-nav-badge.a">
    <Setter Property="Background" Value="{DynamicResource Coral}" />
  </Style>

  <Style Selector="Border.dual-pane-nav-badge.b">
    <Setter Property="Background" Value="{DynamicResource Teal}" />
  </Style>

  <Style Selector="Border.dual-pane-nav-badge.a.active">
    <Setter Property="BoxShadow" Value="0 0 0 3 #44E3563B" />
  </Style>

  <Style Selector="Border.dual-pane-nav-badge.b.active">
    <Setter Property="BoxShadow" Value="0 0 0 3 #442E6F63" />
  </Style>

  <Style Selector="Button.dual-pane-nav-button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="#F7F3EA" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.dual-pane-nav-button:pointerover">
    <Setter Property="Background" Value="#20FFFFFF" />
  </Style>

  <Style Selector="Border.dual-divider-line">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderStrong}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.dual-badge">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.dual-badge.a">
    <Setter Property="Background" Value="{DynamicResource Coral}" />
  </Style>

  <Style Selector="Border.dual-badge.b">
    <Setter Property="Background" Value="{DynamicResource Teal}" />
  </Style>

  <Style Selector="Border.dual-badge.a.active">
    <Setter Property="BoxShadow" Value="0 0 0 3 #44E3563B" />
  </Style>

  <Style Selector="Border.dual-badge.b.active">
    <Setter Property="BoxShadow" Value="0 0 0 3 #442E6F63" />
  </Style>

  <Style Selector="TextBlock.dual-badge-text">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="#FFF9EF" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.dual-empty-card">
    <Setter Property="Width" Value="330" />
    <Setter Property="Padding" Value="26,24" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.dual-empty-detail">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="270" />
  </Style>

  <Style Selector="Border.dual-filmstrip">
    <Setter Property="Height" Value="154" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="#0A0E13" />
    <Setter Property="BorderBrush" Value="#24FFFFFF" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BoxShadow" Value="0 -16 40 0 #3D04070A" />
  </Style>

  <Style Selector="Border.dual-film-half">
    <Setter Property="Padding" Value="9,18,12,18" />
    <Setter Property="Background" Value="#0A0E13" />
  </Style>

  <Style Selector="Border.dual-film-half.a">
    <Setter Property="Padding" Value="9,18,12,18" />
  </Style>

  <Style Selector="Border.dual-film-half.b">
    <Setter Property="Padding" Value="9,18,12,42" />
  </Style>

  <Style Selector="Border.dual-film-half.a.active">
    <Setter Property="Background" Value="#2A1A17" />
  </Style>

  <Style Selector="Border.dual-film-half.b.active">
    <Setter Property="Background" Value="#152522" />
  </Style>

  <Style Selector="Border.dual-film-split">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="#24FFFFFF" />
  </Style>

  <Style Selector="Border.dual-film-badge">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>

  <Style Selector="Border.dual-film-badge.a">
    <Setter Property="Background" Value="{DynamicResource Coral}" />
  </Style>

  <Style Selector="Border.dual-film-badge.b">
    <Setter Property="Background" Value="{DynamicResource Teal}" />
  </Style>

  <Style Selector="Border.dual-film-badge.active.a">
    <Setter Property="BoxShadow" Value="0 0 0 3 #44E3563B" />
  </Style>

  <Style Selector="Border.dual-film-badge.active.b">
    <Setter Property="BoxShadow" Value="0 0 0 3 #442E6F63" />
  </Style>

  <Style Selector="Button.dual-film-close">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#B9B1A5" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Button.dual-film-close:pointerover">
    <Setter Property="Background" Value="#22FFFFFF" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.dual-menu-item">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0,9" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#E4DED3" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.dual-menu-item:pointerover">
    <Setter Property="Background" Value="#18FFFFFF" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.dual-menu-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#18FFFFFF" />
  </Style>

  <Style Selector="Button.dual-menu-item.primary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#F4FFFB" />
  </Style>

  <Style Selector="Button.dual-menu-item.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#332E6F63" />
  </Style>

  <Style Selector="Button.dual-menu-item.hover">
    <Setter Property="Background" Value="#18FFFFFF" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.dual-menu-item.hover /template/ ContentPresenter">
    <Setter Property="Background" Value="#18FFFFFF" />
  </Style>

  <Style Selector="Button.dual-menu-item.primary.hover">
    <Setter Property="Background" Value="#332E6F63" />
    <Setter Property="Foreground" Value="#F4FFFB" />
  </Style>

  <Style Selector="Button.dual-menu-item.primary.hover /template/ ContentPresenter">
    <Setter Property="Background" Value="#332E6F63" />
  </Style>

  <Style Selector="Border.dual-menu">
    <Setter Property="Width" Value="274" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="Background" Value="#F20A0E13" />
    <Setter Property="BorderBrush" Value="#24FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="BoxShadow" Value="0 26 70 0 #6B030609" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.dual-menu-head">
    <Setter Property="Padding" Value="5,5,7,9" />
    <Setter Property="Margin" Value="0,0,0,5" />
    <Setter Property="BorderBrush" Value="#24FFFFFF" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.dual-menu-badge">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>

  <Style Selector="Border.dual-menu-badge.a">
    <Setter Property="Background" Value="{DynamicResource Coral}" />
  </Style>

  <Style Selector="Border.dual-menu-badge.b">
    <Setter Property="Background" Value="{DynamicResource Teal}" />

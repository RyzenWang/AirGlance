    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.edit-action:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>

  <Style Selector="Button.edit-primary">
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="{DynamicResource Coral}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Foreground" Value="{DynamicResource OnCoral}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.edit-primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Coral}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <Style Selector="Border.edit-mode-chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <Style Selector="Button.edit-action /template/ ContentPresenter TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.edit-primary /template/ ContentPresenter TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.edit-chip /template/ ContentPresenter TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.export-segment">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.export-segment.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #24201B14" />
  </Style>

  <Style Selector="Button.export-segment.active">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

</Styles>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirGlance.App.ViewModels"
             x:Class="AirGlance.App.Views.InfoPanelView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
    <ItemsControl ItemsSource="{Binding InfoSections}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:InfoSection">
          <StackPanel Margin="0,0,0,18">
            <TextBlock Classes="sectionLabel" Text="{Binding Title}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InfoRow">
                  <Grid ColumnDefinitions="78,*" Margin="0,0,0,7">
                    <TextBlock Text="{Binding Label}"
                               FontSize="11.5"
                               Foreground="{DynamicResource InkSecondary}"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Value}"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="10.5"
                               TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>

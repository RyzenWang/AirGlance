<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AirGlance.App.Controls"
        x:Class="AirGlance.App.Views.MessageWindow"
        Width="560"
        Height="440"
        MinWidth="420"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFont}"
        FontSize="14"
        Background="{DynamicResource Paper}"
        KeyDown="OnKeyDown">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Spacing="14">
      <Grid x:Name="HeaderGrid" ColumnDefinitions="*,Auto" Margin="24,14,16,0">
        <TextBlock x:Name="TitleText"
                   FontSize="19"
                   FontWeight="SemiBold"
                   LetterSpacing="-0.4"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
        <Button x:Name="HeaderCloseButton"
                Grid.Column="1"
                Classes="icon"
                Width="30"
                Height="30"
                Margin="12,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="OnCloseClick"
                AutomationProperties.Name="{DynamicResource L.Close}"
                ToolTip.Tip="{DynamicResource L.Close}">
          <controls:IconPath Data="{DynamicResource IconClose}" Width="14" Height="14" />
        </Button>
      </Grid>
      <Border Classes="divider" Margin="24,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Padding="24,0,24,8" VerticalScrollBarVisibility="Auto">
      <TextBlock x:Name="BodyText"
                 FontSize="13"
                 Foreground="{DynamicResource InkSecondary}"
                 TextWrapping="Wrap"
                 LineHeight="22" />
    </ScrollViewer>

    <Border Grid.Row="2"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,1,0,0"
            Padding="24,12">
      <Button Classes="primary"
              Content="{DynamicResource L.Close}"
              HorizontalAlignment="Right"
              Click="OnCloseClick" />
    </Border>
  </Grid>
</Window>

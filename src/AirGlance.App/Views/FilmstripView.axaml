<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirGlance.App.ViewModels"
             x:Class="AirGlance.App.Views.FilmstripView"
             x:DataType="vm:MainWindowViewModel">
  <ListBox x:Name="FilmstripList"
           Classes="filmstrip"
           ItemsSource="{Binding Images}"
           SelectedIndex="{Binding CurrentIndex, Mode=OneWay}"
           SelectionChanged="OnSelectionChanged"
           ScrollViewer.HorizontalScrollBarVisibility="Auto"
           ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.ItemTemplate>
      <DataTemplate x:DataType="vm:ImageItemViewModel">
        <StackPanel Width="100" Spacing="3" Margin="2">
          <Grid>
            <Border Width="92" Height="56" CornerRadius="6" Background="#20262E" ClipToBounds="True">
              <Grid>
                <Path Data="{DynamicResource IconImage}"
                      Stroke="{DynamicResource InkTertiary}"
                      StrokeThickness="1.4"
                      Width="22"
                      Height="22"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                <Image Source="{Binding Thumbnail}"
                       Stretch="Uniform"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
              </Grid>
            </Border>
            <Border BorderBrush="{DynamicResource Coral}"
                    BorderThickness="2"
                    CornerRadius="6"
                    IsVisible="{Binding IsCurrent}"
                    IsHitTestVisible="False" />
          </Grid>
          <TextBlock Text="{Binding FileName}"
                     Classes="image-name"
                     Classes.current="{Binding IsCurrent}"
                     MaxWidth="92"
                     HorizontalAlignment="Left" />
        </StackPanel>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AirGlance.App.ViewModels"
        xmlns:controls="using:AirGlance.App.Controls"
        x:Class="AirGlance.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1240"
        Height="860"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource UiFont}"
        FontSize="14"
        Background="{DynamicResource Paper}"
        Icon="avares://AirGlance/Assets/airglance.png"
        DragDrop.AllowDrop="True">
  <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto,Auto">
    <Border x:Name="TitleBar"
            Grid.Row="0"
            Height="44"
            Background="{DynamicResource Paper}"
            IsVisible="{Binding ShowTitleBar}"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto" Height="44">
        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" Spacing="9" VerticalAlignment="Center">
          <Border Width="16" Height="16" CornerRadius="5" Background="{DynamicResource Coral}">
            <Path Data="{DynamicResource IconBrand}"
                  Stroke="{DynamicResource OnCoral}"
                  StrokeThickness="1.3"
                  StrokeLineCap="Round"
                  Stretch="None"
                  Width="12"
                  Height="10"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{DynamicResource L.AppName}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     LetterSpacing="-0.2"
                     VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Column="1"
                   Text="{Binding TitleFileName}"
                   Margin="16,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource InkSecondary}"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel x:Name="CaptionButtons"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    IsVisible="False">
          <Button Classes="caption" Click="OnMinimizeClick" AutomationProperties.Name="{DynamicResource L.Minimize}">
            <Path Data="{DynamicResource IconMinimize}" />
          </Button>
          <Button Classes="caption" Click="OnMaximizeClick" AutomationProperties.Name="{DynamicResource L.Maximize}">
            <Path x:Name="MaximizeIcon" Data="{DynamicResource IconMaximize}" />
          </Button>
          <Button Classes="caption close" Click="OnCloseClick" AutomationProperties.Name="{DynamicResource L.Close}">
            <Path Data="{DynamicResource IconClose}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <Border x:Name="CanvasBorder"
              Grid.Column="0"
              Classes="canvas"
              Classes.fullscreen="{Binding IsFullscreen}"
              ClipToBounds="True">
        <Grid>
          <controls:ImageViewer x:Name="Viewer"
                                CheckerboardEnabled="{Binding CheckerboardEnabled}"
                                CheckerLightBrush="{DynamicResource CheckerLight}"
                                CheckerDarkBrush="{DynamicResource CheckerDark}"
                                FirstFramePresented="OnFirstFramePresented"
                                ZoomChanged="OnViewerZoomChanged"
                                ViewportChanged="OnViewerViewportChanged" />

          <StackPanel x:Name="Overlay"
                      IsVisible="{Binding OverlayVisible}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MaxWidth="480"
                      Spacing="8">
            <TextBlock Text="{Binding OverlayTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       LetterSpacing="-0.4"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding OverlayMessage}"
                       FontSize="14"
                       Foreground="{DynamicResource InkSecondary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding OverlayHint}"
                       FontSize="13"
                       Foreground="{DynamicResource InkTertiary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
          </StackPanel>

          <Border IsVisible="{Binding IsLoading}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Margin="0,0,0,20"
                  Padding="10,6"
                  CornerRadius="{DynamicResource ChipCornerRadius}"
                  Background="{DynamicResource Scrim}"
                  IsHitTestVisible="False">
            <TextBlock Text="{DynamicResource L.Loading}" Foreground="White" FontSize="12" />
          </Border>
        </Grid>
      </Border>

      <Border x:Name="InfoHost"
              Grid.Column="1"
              Width="300"
              Margin="0,12,12,12"
              Classes="panel"
              IsVisible="{Binding InfoShown}" />
    </Grid>

    <Border x:Name="FilmstripHost"
            Grid.Row="2"
            Height="108"
            IsVisible="{Binding FilmstripShown}"
            Background="{DynamicResource SurfaceAlt}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,1,0,0" />

    <Border Grid.Row="3"
            Height="28"
            IsVisible="{Binding IsChromeVisible}"
            Background="{DynamicResource Paper}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    IsVisible="{Binding HasImage}">
          <TextBlock Classes="mono"
                     FontSize="12"
                     Foreground="{DynamicResource InkSecondary}"
                     Text="{Binding StatusDimensions}" />
          <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource InkTertiary}" />
          <Button Classes="link"
                  FontFamily="{DynamicResource MonoFont}"
                  FontSize="12"
                  Content="{Binding ZoomText}"
                  Click="OnZoomPresetClick"
                  ToolTip.Tip="{DynamicResource L.ZoomLevel}"
                  AutomationProperties.Name="{DynamicResource L.ZoomLevel}" />
          <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource InkTertiary}" />
          <TextBlock Classes="mono"
                     FontSize="12"
                     Foreground="{DynamicResource InkSecondary}"
                     Text="{Binding StatusPosition}" />
        </StackPanel>

        <TextBlock Grid.Column="1"
                   Text="{Binding TransientMessage}"
                   FontSize="12"
                   Foreground="{DynamicResource Caution}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="12,0" />

        <Button Grid.Column="2"
                Classes="link"
                FontSize="12"
                Content="GitHub"
                Click="OnGitHubClick"
                AutomationProperties.Name="GitHub" />
      </Grid>
    </Border>

    <Border Grid.RowSpan="4"
            IsVisible="{Binding IsDragOver}"
            BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="2"
            Background="#01000000"
            IsHitTestVisible="False">
      <Border Classes="panel"
              Padding="18,12"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource L.DropHint}" FontSize="14" />
      </Border>
    </Border>
  </Grid>
</Window>


